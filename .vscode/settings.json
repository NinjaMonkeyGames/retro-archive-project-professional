/* eslint-disable jsonc/no-comments */
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                                                    IDE SETTINGS                                                    //
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// 1. Automatic actions.
// 2. Add a visible ruler to the IDE.
// 3. Format settings.
// 4. Set eslint config path.
// 5. Confirmation settings.
// 6. Markdown settings.
// 7. Set cspell config path.
// 8. Include otherwise hidden folders in the file tree view.
// 9. Include otherwise excluded files in the project file search.
// 10. Start Terminal in Bash.
// 11. Automatically format JSON files on save.
// 12. PHPCS Settings.
// 13. Set commitlint config path.
// 14. Markdown settings.

{

  // Markdown Settings

  "[markdown]":
  {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.formatOnSave": true
  },

  // Set cspell config path

  "cSpell.import": ["./.config/cspell.json"],


  // Set commitlint config path

  "commitlint.config.file": ".config/commitlint.config.mjs",

  "editor.formatOnSave": true, // Automatically format files when saving
  "editor.formatOnType": true, // Automatically format code as you type

  // Add a Visible Ruler to the IDE

  "editor.rulers":
  [
    120 // set ruler width to 120 characters
  ],

  "editor.wordWrap": "wordWrapColumn", // Automatically wrap lines of text
  "editor.wordWrapColumn": 120, // Set the wrap column to 120 characters

  // Format Settings

  "editor.wrappingIndent": "same", // Keep indentation level of wrapped lines

  // Set eslint config path

  "eslint.options": { "overrideConfigFile": ".config/eslint.config.js" },
  "eslint.workingDirectories": ["."],
  // Confirmation Settings

  "explorer.confirmDelete": false, // Prevents prompt when deleting files
  "explorer.confirmDragAndDrop": false, // Prevents prompt when moving files
  "explorer.excludeGitIgnore": false, // Prevent VS Code from hiding gitignored files/folders
  "files.autoSave": "afterDelay", // All file changes will be saved periodically
  "files.autoSaveDelay": 1000, // Set autosave delay for 1000 milliseconds
  "files.eol": "\n", // Force all new files to be in LF format opposed to CRLF

  // Include Otherwise Hidden Folders In The File Tree View

  "files.exclude":
  {
    "**/.git": false, // Show .git folder
    "**/node_modules": false // Show node_modules
  },

  // Automatically format JSON files on save

  "json.format.enable": false,

  "markdown.extension.toc.updateOnSave": true, // Automatically update the TOC when saving markdown files
  "markdownlint.configFile": ".config/.markdownlint-cli2.jsonc", // Set markdownlint config path

  // PHPCS Settings

  "phpcs.executablePath": "vendor/bin/phpcs",
  "phpcs.standard": ".config/phpcs.xml",

  // Include Otherwise Excluded Files In Project File Search

  "search.exclude":
  {
    "**/.git": false, // Include (Exclude) .git folder
    "**/node_modules": false // Include (Exclude) node_modules folder
  },

  // Start Terminal in Bash

  "terminal.integrated.defaultProfile.linux": "bash"
}