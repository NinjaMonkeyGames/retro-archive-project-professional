{
  "id": 22478466,
  "name": "Require a pull request before merging- Develop - Squash",
  "target": "branch",
  "source_type": "Repository",
  "source": "NinjaMonkeyGames/gamemaker-project-template",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/develop"
